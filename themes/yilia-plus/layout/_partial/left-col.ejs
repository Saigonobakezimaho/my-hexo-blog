<% var defaultBg = '#4d4d4d'; %>
<% var defaultBgImg = '/img/biubiubiu.gif'; %>
<% var overlayBgImg= theme.style.gif && theme.style.gif.enable && theme.style.gif.path ? theme.style.gif.path : defaultBgImg; %>
<div class="overlay" style="background: <%= theme.style && theme.style.header ? theme.style.header : defaultBg %>;<% if (theme.style.gif && theme.style.gif.enable){ %>background: url('<%- url_for(overlayBgImg) %>') no-repeat ;<%}%>"></div>
<div class="intrude-less">
	<header id="header" class="inner">
		<a href="<%- url_for('/') %>" class="profilepic">
			<img src="<%- url_for(theme.avatar) %>" class="js-avatar">
		</a>
		<hgroup>
			<h1 class="header-author"><a href="<%- url_for('/') %>"><%= config.author %></a></h1>
		</hgroup>
		<% if (config.subtitle) { %>
		<p class="header-subtitle"><%= config.subtitle %></p>
		<%}%>

		<nav class="header-menu">
			<ul>
			<% for (var i in theme.menu){ %>
				<li><a href="<%- url_for(theme.menu[i]) %>" <% if (theme.open_in_new.menu){ %>target="_blank"<% } %>><%= i %></a></li>
			<%}%>
			</ul>
		</nav>
		<nav class="header-smart-menu">
			<% for (var i in theme.smart_menu){ %>
				<% if(theme.smart_menu[i]){ %>
					<a q-on="click: openSlider(e, '<%-i%>')" href="javascript:void(0)"><%= theme.smart_menu[i] %></a>
				<% } %>
			<%}%>
		</nav>
		<nav class="header-nav">
			
		<% if (theme.music && theme.music.enable){ %>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/aplayer/dist/APlayer.min.css">
			<script src="https://cdn.jsdelivr.net/npm/aplayer/dist/APlayer.min.js"></script>
			
			<div id="aplayer-container" style="margin: 20px auto; width: 240px; min-height: 80px;"></div>
			<script>
			(function () {
				var playlist = <%- JSON.stringify((theme.music.list || []).map(function (song) {
					return {
						name: song.name || song.file,
						artist: song.artist || theme.music.artist || '',
						url: '/music/' + song.file,
						cover: song.cover || theme.music.cover || '',
						lrc: song.lrc || theme.music.lrc || ''
					};
				})) %>;
				new APlayer({
					container: document.getElementById('aplayer-container'),
					theme: '#4d4d4d',
					autoplay: <%= theme.music.autoPlay ? 'true' : 'false' %>,
					listFolded: true,
					listMaxHeight: '200px',
					audio: playlist
				});
			})();
			</script>
		<% } %>

		</nav>
	</header>		
</div>